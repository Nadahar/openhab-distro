	bnd.identity;id='org.eclipse.equinox.metatype',\
	${feature.logging},\
	${feature.debug},\
	${feature.openhab-base},\
	${feature.openhab-model-runtime-all},\
	${feature.graalvm-core},\
	${feature.jsscripting},\
	${feature.pythonscripting},\
